{
    "name": "n8n-nodes-revana",
    "version": "0.1.0",
    "description": "n8n community node for Revana: generate AI video, images and music (Seedance 2.5, Veo 3.1, Kling, Nano Banana, GPT Image and 200+ models) and chat with LLMs through one API key.",
    "license": "MIT",
    "homepage": "https://revana.si",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "revana",
        "ai video",
        "video generation",
        "image generation",
        "seedance",
        "veo",
        "kling",
        "nano banana",
        "text to video",
        "llm"
    ],
    "author": {
        "name": "Revana",
        "email": "hello@revana.si",
        "url": "https://revana.si"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Aribk7/n8n-nodes-revana.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/RevanaApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/Revana/Revana.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
